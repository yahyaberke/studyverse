# ---- Server ----
# NODE_ENV is set by the scripts (dev) or your host (production); do not set it here
PORT=4000
# Comma-separated list of allowed browser origins (the client URL)
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://studyverse:studyverse_dev_password@localhost:5433/studyverse?schema=public
# Optional. When set, Socket.IO uses the Redis adapter and presence/rate limits are shared across instances.
REDIS_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set true behind HTTPS (production). Cookies become Secure.
COOKIE_SECURE=false

# ---- Email (password reset) ----
# MAIL_TRANSPORT: "none" (reset disabled), "console" (dev only: links printed to server log), "smtp"
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StudyVerse <no-reply@example.com>"

# ---- Study session policy ----
# Active focus segment is auto-paused if no heartbeat for this many seconds
SESSION_STALE_SECONDS=600
# Paused/abandoned sessions are auto-finished after this many hours
SESSION_AUTO_FINISH_HOURS=12

# ---- Client (Vite) ----
VITE_APP_NAME=StudyVerse
