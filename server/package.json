{
  "name": "@studyverse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "@studyverse/shared": "0.1.0",
    "argon2": "0.45.1",
    "cookie": "^1.0.2",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "8.3.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "9.0.3",
    "luxon": "3.7.2",
    "nodemailer": "^10.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^5.0.5"
  }
}
